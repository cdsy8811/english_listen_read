# 配置模板 — 复制为 .env.local 后填入真实值
# 真实凭据见 docs/讯飞接口配置.md（本地文件，已被 .gitignore 排除）
#
# 方案 C（已定）：构建期由 Vite 把这些值注入产物，App 端自行签名并直连讯飞，
# 不需要电脑 / 服务器 / 云函数。**源码仓库只放键名，不放真实值**；
# 密钥最终只存在于 APK 中，须分片混淆 + 代码混淆 + 打包加固 + 控制台限额告警。
# 严禁把真实值写进 src/、注释、manifest.json、pages.json、日志或提交记录。

# ---- MaaS 大模型（Spark X2.6，OpenAI 兼容 / Bearer 鉴权）----
XFYUN_MAAS_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
XFYUN_MAAS_MODEL=spark-x2.6
XFYUN_MAAS_API_KEY=ak-REPLACE_ME

# ---- WebSocket 语音能力（HMAC-SHA256 签名鉴权）----
XFYUN_APPID=REPLACE_ME
XFYUN_API_KEY=REPLACE_ME
XFYUN_API_SECRET=REPLACE_ME
XFYUN_IAT_WSS=wss://iat.cn-huabei-1.xf-yun.com/v1
XFYUN_TTS_WSS=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/mcd9m97e6
# 超拟人合成没有 language 参数，语种靠发音人 vcn 切换；需在控制台确认已领取
XFYUN_TTS_VCN_ZH=REPLACE_ME
XFYUN_TTS_VCN_EN=REPLACE_ME

# ---- 通用文档识别（OCR大模型，HTTPS POST，与语音共用签名三元组）----
XFYUN_OCR_URL=https://cbm01.cn-huabei-1.xf-yun.com/v1/private/se75ocrbm
# 2026-11-06 实测：api.xf-yun.com 与 cbm01... 两种 host 都返回 code=0；
# 默认与实际请求域名一致，保留该项以便官方网关行为变化时切回
XFYUN_OCR_SIGN_HOST=cbm01.cn-huabei-1.xf-yun.com

# ---- 语音评测 ISE：第一版已决定不接，2.2 只做「内容正确度」，以下仅备查 ----
XFYUN_ISE_WSS=wss://ise-api.xfyun.cn/v2/open-ise
XFYUN_ISE_SIGN_HOST=ise-api.xfyun.cn
# 讯飞按「应用+服务」发密钥，ISE 可能与上面三元组不同；留空才复用上面的值
XFYUN_ISE_APPID=
XFYUN_ISE_API_KEY=
XFYUN_ISE_API_SECRET=

# ---- 仅开发调试用（正式 APK 不使用）----
# tools/proxy.py 的本机代理地址；方案 C 下 App 不连它，留着只为联调复现签名
# DEV_PROXY_BASE_URL=http://localhost:8787
